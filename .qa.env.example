# Copy this file to .qa.env and fill in the QA host details used by
# infra/qa/install.sh, update.sh, deploy-app.sh, and deploy-local.sh.
# Never place the SSH private key itself inside this repository.

QA_SSH_HOST=209.0.113.10
QA_SSH_USER=root
QA_SSH_KEY=/absolute/path/to/qa_ed25519
QA_KNOWN_HOSTS_FILE=/absolute/path/to/known_hosts
QA_PUBLIC_HOST=qa.example.com

# Optional. This is the documented public installer by default.
QA_INSTALL_URL=https://remote.futrx.com/get

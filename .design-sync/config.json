{
  "projectId": "a7c2e67d-89c5-4038-90cf-39546ae43599",
  "pkg": "remote.futrx-web",
  "globalName": "FutrX",
  "shape": "package",
  "entry": "./frontend/ds-entry.ts",
  "buildCmd": "cd frontend && npm i --no-save react@18 react-dom@18 @types/react@18 && npx tailwindcss -c ../.design-sync/tailwind.sync.ts -i src/index.css -o .ds-css/tailwind.css && rm -rf .ds-dts && npx tsc ds-entry.ts --jsx react-jsx --jsxImportSource preact --declaration --emitDeclarationOnly --declarationDir .ds-dts --moduleResolution bundler --target es2020 --module esnext --skipLibCheck --allowImportingTsExtensions",
  "tsconfig": "../.design-sync/tsconfig.sync.json",
  "cssEntry": "./.ds-css/tailwind.css",
  "componentSrcMap": {
    "LoadingScreen": "src/ui/primitives/LoadingScreen.tsx",
    "Skeleton": "src/ui/primitives/Skeleton.tsx",
    "Loading": "src/ui/projects/project-containers/ProjectContainerPrimitives.tsx",
    "Empty": "src/ui/projects/project-containers/ProjectContainerPrimitives.tsx",
    "Panel": "src/ui/projects/project-containers/ProjectContainerPrimitives.tsx",
    "Grid": "src/ui/projects/project-containers/ProjectContainerPrimitives.tsx",
    "Field": "src/ui/projects/project-containers/ProjectContainerPrimitives.tsx",
    "UserMessage": "src/ui/chat/messages/UserMessage.tsx",
    "MessageBlock": "src/ui/chat/messages/MessageBlock.tsx",
    "StreamingText": "src/ui/chat/messages/StreamingText.tsx",
    "ErrorMessage": "src/ui/chat/messages/ErrorMessage.tsx",
    "ThinkingIndicator": "src/ui/chat/messages/ThinkingIndicator.tsx",
    "ThreadEmptyState": "src/ui/chat/messages/ThreadEmptyState.tsx",
    "JumpToLatestButton": "src/ui/chat/messages/JumpToLatestButton.tsx",
    "MessageSkeleton": "src/ui/chat/messages/MessageSkeleton.tsx",
    "ChatSkeleton": "src/ui/chat/ChatSkeleton.tsx",
    "ToolShell": "src/ui/chat/tool-calls/ToolShell.tsx",
    "CodeBlock": "src/ui/chat/tool-calls/CodeBlock.tsx",
    "DiffView": "src/ui/chat/history/DiffView.tsx",
    "AskUserQuestion": "src/ui/chat/tool-calls/ask-user-question/AskUserQuestion.tsx",
    "QuestionOption": "src/ui/chat/tool-calls/ask-user-question/QuestionOption.tsx",
    "QuestionProgress": "src/ui/chat/tool-calls/ask-user-question/QuestionProgress.tsx",
    "AnsweredSummary": "src/ui/chat/tool-calls/ask-user-question/AnsweredSummary.tsx",
    "AttachmentChip": "src/ui/chat/composer/AttachmentChip.tsx",
    "AttachButton": "src/ui/chat/composer/AttachButton.tsx",
    "SendControls": "src/ui/chat/composer/SendControls.tsx",
    "SelectedSkillChips": "src/ui/chat/composer/SelectedSkillChips.tsx",
    "ComposerDropOverlay": "src/ui/chat/composer/ComposerDropOverlay.tsx",
    "UsagePill": "src/ui/chat/header/UsagePill.tsx",
    "ModelPicker": "src/ui/chat/header/ModelPicker.tsx",
    "WorkspaceActions": "src/ui/chat/header/WorkspaceActions.tsx",
    "ProjectStatusDot": "src/ui/sidebar/ProjectStatusDot.tsx",
    "ProjectGroup": "src/ui/sidebar/ProjectGroup.tsx",
    "AccountFooter": "src/ui/sidebar/AccountFooter.tsx",
    "WorkspaceSearch": "src/ui/sidebar/WorkspaceSearch.tsx",
    "SidebarEmptyState": "src/ui/sidebar/SidebarEmptyState.tsx",
    "SidebarNoMatches": "src/ui/sidebar/SidebarEmptyState.tsx",
    "SidebarSkeleton": "src/ui/sidebar/SidebarSkeleton.tsx",
    "NoChatSelected": "src/ui/layout/NoChatSelected.tsx",
    "BrowserEmptyState": "src/ui/chat/browser/BrowserEmptyState.tsx",
    "Markdown": "src/ui/chat/markdown/Markdown.tsx",
    "DsSurface": null
  },
  "extraEntries": [
    "./src/ui/primitives/icons.tsx"
  ],
  "provider": {
    "component": "DsSurface"
  },
  "readmeHeader": ".design-sync/conventions.md"

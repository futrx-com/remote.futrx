# Caddyfile for remote.futrx — managed by infra/install.sh.
#
# Platform and application site blocks:
#   1. ${HOSTNAME}            main chat UI + backend API
#   2. *.${HOSTNAME}          named application origins (<label>--<project>.<host>)
#   3. *.dev.${HOSTNAME}      per-project dev URLs (<slug>--<port>.dev.<host>)
#
# All use Remote authentication. Dev URLs use forward_auth; the
# application gateway validates sessions and project membership itself.

{
    # Email used for Let's Encrypt ACME registration. Set to a real address
    # if you want renewal-failure emails from LE.
    # email you@example.com

    # On-demand TLS for dev and application subdomains. Caddy queries the
    # backend's /internal/tls-ask before issuing each cert so attackers
    # can't burn through ACME rate limits by hitting random subdomains.
    on_demand_tls {
        ask http://127.0.0.1:${SERVICE_PORT}/internal/tls-ask
    }
}

${HOSTNAME} {
    encode zstd gzip
    # Defense in depth: /internal/* is reachable only on loopback (Caddy →
    # backend). Reject any external attempt.
    @internal path /internal/*
    handle @internal {
        respond 403
    }
    reverse_proxy 127.0.0.1:${SERVICE_PORT}
}

# Manifest-defined <label>--<project>.<host> origins use the platform wildcard.
# Preview hosts retain their separate routing below.
# Certificates are on-demand per host, admitted by /internal/tls-ask like previews.
*.${HOSTNAME} {
    encode zstd gzip
    tls {
        on_demand
    }
    @named header_regexp named Host (?i)^[a-z0-9-]+--[a-z0-9-]+\.${HOSTNAME_RE}\.?(?::[0-9]+)?$
    handle @named {
        # The trusted gateway needs the session cookie to authenticate the caller
        # and check project membership. After authorization, newWebProxy removes
        # all Cookie and Authorization headers before forwarding to the container.
        reverse_proxy 127.0.0.1:${SERVICE_PORT}
    }
    handle {
        respond 404
    }
}

# Per-project dev URLs. <slug>--<port>.dev.${HOSTNAME} proxies into the
# project's LXD container at <slug>.lxd:<port>. The .lxd resolution
# depends on the systemd-resolved drop-in installed by infra/steps/01-host-deps.sh.
*.dev.${HOSTNAME} {
    encode zstd gzip
    tls {
        on_demand
    }
    forward_auth 127.0.0.1:${SERVICE_PORT} {
        uri /auth/verify
    }
    @internal path /internal/*
    handle @internal {
        respond 403
    }
    # The Browser drawer's inspect mode serves a wrapper from the same dev
    # subdomain as the previewed app, so it can inspect iframe DOM and post
    # selected element metadata back to the main chat UI.
    handle /__remote_inspector {
        reverse_proxy 127.0.0.1:${SERVICE_PORT}
    }
    @valid {
        header_regexp host Host ^([a-z0-9][a-z0-9-]*)--(\d{4,5})\.dev\.${HOSTNAME_RE}$
    }
    handle @valid {
        reverse_proxy {re.host.1}.lxd:{re.host.2} {
            # Strip remote.futrx's own auth cookies before the request
            # enters the project container. forward_auth (above) already
            # validated the session against the main backend on loopback, so
            # the gate is unaffected; this stops any code running inside a
            # dev server from harvesting the admin session token (which would
            # otherwise be replayable against ${HOSTNAME} for platform access).
            # remote_share is the public-preview grant: host-scoped to this
            # one <slug>--<port> origin, so this is the only block that can
            # ever see it, and the app inside must not be able to read it.
            # The app's own cookies pass through untouched.
            header_up Cookie `(?:^|;\s*)(?:remote_session|remote_2fa_pending|remote_oauth_state|return_to)=[^;]*` ""
        }
    }
    respond "Use <slug>--<port>.dev.${HOSTNAME} (e.g. myproj--3000.dev.${HOSTNAME})" 400
}

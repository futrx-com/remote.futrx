# The single version manifest for remote.futrx — every pinned external
# component lives in this one file. The backend embeds it (versions.go) so
# container provisioning is self-contained, and infra/versions.env is a
# symlink to it so the infra shell scripts source the same values. Edit
# either path; they are the same file.
#
# Bumping a pin: change the value here and re-run `sudo bash infra/update.sh`
# on a box. For the PW_* pins also run the "Vendor Playwright assets"
# workflow (or vendors/publish-playwright-assets.sh) so the fallback release
# assets exist for the new version — see vendors/README.md.

# ── Agent CLIs (installed on the host and/or in containers) ──
CLAUDE_CODE_VERSION=2.1.280
CODEX_CLI_VERSION=0.156.1
KIMI_CODE_VERSION=2.1.0
# Antigravity ships standalone per-architecture release archives. When bumping
# its version, update both SHA-512 pins from the matching GitHub release assets.
ANTIGRAVITY_CLI_VERSION=1.2.9
ANTIGRAVITY_LINUX_X64_SHA512=75e83d46cb1632da4aca29b785017753c8c2dfb0320166da6b2c8007678982943515e64c8824ff2d8510d9b52eb2b3c27f306aeec58c4a4f4f8aa5550cb0cb12
ANTIGRAVITY_LINUX_ARM64_SHA512=524daf6ce6138d58455f3b82eba4923b3da2d4f874eda31a7699fb0275d18de3d4ae6d2c3acc4b43fdb063f6c51adaab42785054cd1852b8455892fa2404d019

# ── Host toolchain ──
# NodeSource major stream (latest minor within it); also the Node major
# baked into the container base image.
NODE_MAJOR=22
# Minimum required by the pinned Claude Code and Kimi Code packages.
NODE_MIN_VERSION=22.19.0
# Exact upstream tarball, installed to /usr/local/go.
GO_VERSION=1.25.13

# ── Agent browser stack (Playwright + Chrome for Testing) ──
# PLAYWRIGHT_VERSION drives the rest: PW_CFT_VERSION and PW_FFMPEG_BUILD must
# match what `npx playwright@<version> install chromium --dry-run` reports.
# The vendor workflow cross-checks that and publishes the three Linux assets
# to the GitHub release named by PW_VENDOR_RELEASE_TAG; the sha256 pins gate
# the install-time fallback when Google's CDN geo-blocks a server's IP.
PLAYWRIGHT_VERSION=1.60.0
PW_CFT_VERSION=148.0.7778.96
PW_FFMPEG_BUILD=1011
PW_VENDOR_REPO=futrx-com/remote.futrx
PW_VENDOR_RELEASE_TAG=vendors-playwright-1.60.0
PW_CHROME_LINUX64_SHA256=e58a0612f6156ad287ff392c681f6e1154d0c938feccf631d0c5d7abf3bbf81a
PW_HEADLESS_SHELL_LINUX64_SHA256=88817c574c1838a39f88fda0bbd043b4481fd385fb10e92c323e230844d636ce
PW_FFMPEG_LINUX_SHA256=ebc74fc5b94830176a3c2914ae96bd8bc7f6a91f4f33890230f84a172ee61ccc

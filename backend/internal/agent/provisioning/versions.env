# The single version manifest for remote.futrx — every pinned external
# component lives in this one file. The backend embeds it (versions.go) so
# container provisioning is self-contained, and infra/versions.env is a
# symlink to it so the infra shell scripts source the same values. Edit
# either path; they are the same file.
#
# Bumping a pin: change the value here and re-run `sudo bash infra/update.sh`
# on a box. For the PW_* pins also run the "Vendor Playwright assets"
# workflow (or vendors/publish-playwright-assets.sh) so the fallback release
# assets exist for the new version — see vendors/README.md.

# ── Agent CLIs (installed on the host and/or in containers) ──
CLAUDE_CODE_VERSION=2.1.285
CODEX_CLI_VERSION=0.159.2
KIMI_CODE_VERSION=2.1.1
# Antigravity ships standalone per-architecture release archives. When bumping
# its version, update both SHA-512 pins from the matching GitHub release assets.
ANTIGRAVITY_CLI_VERSION=1.2.14
ANTIGRAVITY_LINUX_X64_SHA512=fd771dfc74ddd07b61c8b0a6fd7a238f53a3a098a51052583a01d97ab84ee60db741ce5f041e87a9da3c1a9aabe95b053113374437df1e231773552781edaf09
ANTIGRAVITY_LINUX_ARM64_SHA512=d96a67d6952a8ec1da16c8b6515f1393ed0260658cf104d9b57b8d13c92c591322ed5e08a62894842be81888116da0f5f80def7971c913d1f462300103426954

# ── Host toolchain ──
# NodeSource major stream (latest minor within it); also the Node major
# baked into the container base image.
NODE_MAJOR=22
# Minimum supported host Node patch.
NODE_MIN_VERSION=22.23.4
# Exact upstream tarball, installed to /usr/local/go.
GO_VERSION=1.25.13

# ── Agent browser stack (independently patched Chrome for Testing) ──
# Chrome is pinned independently of Playwright's bundled browser. Both Linux
# architectures must use the exact security-patched build. FFmpeg must match
# the Playwright driver's browsers.json. All archives are checked on both the
# upstream and vendored download paths.
PLAYWRIGHT_VERSION=1.60.0
PW_CFT_VERSION=156.0.8078.80
PW_FFMPEG_BUILD=1011
PW_VENDOR_REPO=futrx-com/remote.futrx
PW_VENDOR_RELEASE_TAG=vendors-browser-156.0.8078.80-pw-1.60.0
PW_CHROME_LINUX64_SHA256=b711c720f774be355197f32edf37e0651418ba036d92446ee2da19ac017540a7
PW_CHROME_LINUX_ARM64_SHA256=1f496a826c9ba4d6a5f5bf2de686145fe718528c2cc3dbeb96b5893b89653724
PW_FFMPEG_LINUX_SHA256=ebc74fc5b94830176a3c2914ae96bd8bc7f6a91f4f33890230f84a172ee61ccc
PW_FFMPEG_LINUX_ARM64_SHA256=2628c03f05318ff812c8c9baaf207dea2ddf53e818c0dc936714b0fbe3afb009

{
  "id": "backend-playground",
  "name": "Backend Playground",
  "description": "Developer fixture: a Go plugin that exercises every part of the backend API, with a UI that calls it.",
  "category": "development",
  "version": "1",
  "icon": "ui/assets/logo.svg",
  "type": "backend",
  "scopes": ["global", "project"],
  "backend": {
    "access": "registered",
    "timeoutMs": 10000
  },
  "ui": {
    "entry": "scripts/main.js",
    "styles": ["style/playground.css"],
    "views": {
      "panel": "views/panel.html",
      "console": "views/console.html"
    }
  }
}

{
  "id": "terminal",
  "name": "Terminal",
  "description": "A shell in the project container, docked beside the chat.",
  "category": "development",
  "version": "4",
  "icon": "terminal",
  "scopes": ["project", "global"],
  "globallyInstalledInsideContainers": true,
  "service": {
    "name": "remote-terminal",
    "description": "Project terminal sessions",
    "command": ["/usr/local/bin/remote-terminal", "serve"],
    "restart": "on-failure",
    "restartSec": 2
  },
  "backend": {
    "timeoutMs": 30000,
    "background": true
  },
  "ui": {
    "entry": "scripts/main.js",
    "styles": ["style/xterm.css", "style/terminal.css"]
  }
}

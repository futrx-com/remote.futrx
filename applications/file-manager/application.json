{
  "id": "file-manager",
  "name": "File Manager",
  "description": "Browse, search, and download files from a project workspace.",
  "category": "development",
  "version": "6",
  "icon": "folder",
  "scopes": ["project", "global"],
  "preinstall": "infra/preinstall.sh",
  "uninstall": "infra/uninstall.sh",
  "backend": {
    "timeoutMs": 300000,
    "background": true
  },
  "ui": {
    "entry": "scripts/main.js",
    "styles": ["style/files.css"]
  }
}

#!/usr/bin/env bash
set -euo pipefail

PROGRAM="${0##*/}"

usage() {
  cat <<'EOF'
Usage:
  remote-schedule create --name NAME --prompt PROMPT --at RFC3339 [--timezone IANA] [--max-runs N]
  remote-schedule create --name NAME --prompt PROMPT --cron "M H DOM MON DOW" --timezone IANA [--max-runs N]
  remote-schedule list
  remote-schedule pause ID
  remote-schedule resume ID
  remote-schedule delete ID
  remote-schedule run-now ID
  remote-schedule complete-current

Environment:
  REMOTE_APPLICATION_API    Shared application API URL, for example
                         http://host/agent-api/applications
  REMOTE_APPLICATION_GRANT  Bearer capability grant for the current chat
EOF
}

die() {
  printf '%s: %s\n' "$PROGRAM" "$*" >&2
  exit 2
}

require_runtime() {
  [ -n "${REMOTE_APPLICATION_API:-}" ] ||
    die "REMOTE_APPLICATION_API is not set; scheduled-task access is unavailable in this run"
  [ -n "${REMOTE_APPLICATION_GRANT:-}" ] ||
    die "REMOTE_APPLICATION_GRANT is not set; scheduled-task access is unavailable in this run"
  command -v curl >/dev/null 2>&1 || die "curl is required"
  command -v jq >/dev/null 2>&1 || die "jq is required"

  API="${REMOTE_APPLICATION_API%/}/scheduled-tasks/tasks"
}

require_id() {
  local id="${1:-}"
  [ -n "$id" ] || die "a schedule ID is required"
  [[ "$id" =~ ^[A-Za-z0-9._-]+$ ]] ||
    die "invalid schedule ID; expected letters, numbers, '.', '_' or '-'"
}

print_response() {
  local response_file="$1"
  local status="$2"

  if [ ! -s "$response_file" ]; then
    jq -n --argjson status "$status" '{ok: true, status: $status}'
    return
  fi

  if jq -e . "$response_file" >/dev/null 2>&1; then
    jq . "$response_file"
  else
    cat "$response_file"
    printf '\n'
  fi
}

request() {
  local method="$1"
  local path="$2"
  local body="${3:-}"
  local response_file
  local status
  local -a curl_args

  response_file="$(mktemp)"

  curl_args=(
    --silent
    --show-error
    --connect-timeout 10
    --max-time 30
    --output "$response_file"
    --write-out '%{http_code}'
    --request "$method"
    --header @/dev/fd/3
    --header "Accept: application/json"
  )
  if [ -n "$body" ]; then
    curl_args+=(
      --header "Content-Type: application/json"
      --data-binary "$body"
    )
  fi

  if ! status="$(curl "${curl_args[@]}" "${API}${path}" 3<<<"Authorization: Bearer ${REMOTE_APPLICATION_GRANT}")"; then
    rm -f "$response_file"
    die "could not reach the Remote schedule API"
  fi
  if [[ ! "$status" =~ ^[0-9]{3}$ ]]; then
    rm -f "$response_file"
    die "schedule API returned an invalid HTTP status: $status"
  fi

  if (( status < 200 || status >= 300 )); then
    printf '%s: schedule API request failed (HTTP %s)\n' "$PROGRAM" "$status" >&2
    if [ -s "$response_file" ]; then
      if jq -e . "$response_file" >/dev/null 2>&1; then
        jq . "$response_file" >&2
      else
        cat "$response_file" >&2
        printf '\n' >&2
      fi
    fi
    rm -f "$response_file"
    exit 1
  fi

  print_response "$response_file" "$status"
  rm -f "$response_file"
}

create_schedule() {
  local name=""
  local prompt=""
  local at=""
  local cron=""
  local timezone=""
  local max_runs=""
  local kind=""
  local payload=""

  while (( $# > 0 )); do
    case "$1" in
      --name)
        (( $# >= 2 )) || die "--name requires a value"
        name="$2"
        shift 2
        ;;
      --prompt)
        (( $# >= 2 )) || die "--prompt requires a value"
        prompt="$2"
        shift 2
        ;;
      --at)
        (( $# >= 2 )) || die "--at requires an RFC3339 value"
        at="$2"
        shift 2
        ;;
      --cron)
        (( $# >= 2 )) || die "--cron requires a five-field expression"
        cron="$2"
        shift 2
        ;;
      --timezone)
        (( $# >= 2 )) || die "--timezone requires an IANA timezone"
        timezone="$2"
        shift 2
        ;;
      --max-runs)
        (( $# >= 2 )) || die "--max-runs requires a positive integer"
        max_runs="$2"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "unknown create option: $1"
        ;;
    esac
  done

  [ -n "$name" ] || die "create requires --name"
  [ -n "$prompt" ] || die "create requires --prompt"
  if [ -n "$at" ] && [ -n "$cron" ]; then
    die "create accepts exactly one of --at or --cron"
  fi
  if [ -z "$at" ] && [ -z "$cron" ]; then
    die "create requires exactly one of --at or --cron"
  fi

  if [ -n "$at" ]; then
    [[ "$at" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$ ]] ||
      die "--at must be RFC3339, including Z or an explicit UTC offset"
    kind="once"
  else
    local -a cron_fields
    read -r -a cron_fields <<<"$cron"
    (( ${#cron_fields[@]} == 5 )) ||
      die "--cron must contain exactly five fields (minute hour day-of-month month day-of-week)"
    [ -n "$timezone" ] ||
      die "cron schedules require --timezone with an IANA name such as America/Toronto"
    [[ "$timezone" =~ ^[A-Za-z][A-Za-z0-9._+-]*(/[A-Za-z0-9._+-]+)*$ ]] ||
      die "--timezone must be an IANA name such as America/Toronto or UTC"
    kind="cron"
  fi

  if [ -n "$max_runs" ]; then
    [[ "$max_runs" =~ ^[1-9][0-9]*$ ]] ||
      die "--max-runs must be a positive integer"
  fi

  payload="$(
    jq -n \
      --arg name "$name" \
      --arg prompt "$prompt" \
      --arg kind "$kind" \
      '{name: $name, prompt: $prompt, kind: $kind}'
  )"
  if [ -n "$at" ]; then
    payload="$(jq --arg at "$at" '. + {at: $at}' <<<"$payload")"
  fi
  if [ -n "$cron" ]; then
    payload="$(jq --arg cron "$cron" '. + {cron: $cron}' <<<"$payload")"
  fi
  if [ -n "$timezone" ]; then
    payload="$(jq --arg timezone "$timezone" '. + {timezone: $timezone}' <<<"$payload")"
  fi
  if [ -n "$max_runs" ]; then
    payload="$(jq --argjson maxRuns "$max_runs" '. + {maxRuns: $maxRuns}' <<<"$payload")"
  fi

  request POST "" "$payload"
}

main() {
  local command_name="${1:-}"
  if [ -z "$command_name" ]; then
    usage >&2
    exit 2
  fi
  shift

  case "$command_name" in
    -h|--help|help)
      usage
      ;;
    create)
      require_runtime
      create_schedule "$@"
      ;;
    list)
      (( $# == 0 )) || die "list does not accept arguments"
      require_runtime
      request GET ""
      ;;
    pause)
      (( $# == 1 )) || die "pause requires exactly one schedule ID"
      require_id "$1"
      require_runtime
      request PATCH "/$1" '{"enabled":false}'
      ;;
    resume)
      (( $# == 1 )) || die "resume requires exactly one schedule ID"
      require_id "$1"
      require_runtime
      request PATCH "/$1" '{"enabled":true}'
      ;;
    delete)
      (( $# == 1 )) || die "delete requires exactly one schedule ID"
      require_id "$1"
      require_runtime
      request DELETE "/$1"
      ;;
    run-now)
      (( $# == 1 )) || die "run-now requires exactly one schedule ID"
      require_id "$1"
      require_runtime
      request POST "/$1/run"
      ;;
    complete-current)
      (( $# == 0 )) || die "complete-current does not accept arguments"
      require_runtime
      request POST "/current/complete"
      ;;
    *)
      usage >&2
      die "unknown command: $command_name"
      ;;
  esac
}

main "$@"
